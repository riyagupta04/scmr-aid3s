# Copy this file to .env and fill in your values

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/conference?retryWrites=true&w=majority

# Long random string used to sign admin login tokens
JWT_SECRET=change-me-to-a-long-random-string

PORT=5000

# Comma-separated list of allowed frontend origins (needed only if frontend is hosted separately)
CLIENT_ORIGIN=http://localhost:5173

# First admin account, created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123
